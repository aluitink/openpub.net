@model ICollection<ActivityPub.WebUI.Services.UserReport>

<h2>Pending Reports</h2>

@if (!Model.Any())
{
    <p>No pending reports.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Reporter</th>
                <th>Target</th>
                <th>Reason</th>
                <th>Activity</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model)
            {
                <tr>
                    <td>@report.Id</td>
                    <td>@report.ReporterUsername</td>
                    <td>@report.TargetUsername</td>
                    <td>@report.Reason</td>
                    <td>@(report.ActivityId ?? "N/A")</td>
                    <td>@report.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <form asp-action="DismissReport" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="reportId" value="@report.Id" />
                            <button type="submit" class="btn btn-sm btn-secondary">Dismiss</button>
                        </form>
                        <form asp-action="TakeActionReport" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="reportId" value="@report.Id" />
                            <button type="submit" class="btn btn-sm btn-danger">Take Action</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-action="Moderation" class="btn btn-secondary">Back to Moderation</a>
