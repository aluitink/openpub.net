@model ActivityPub.WebUI.Controllers.TrendsViewModel
@{
    ViewData["Title"] = "Trending";
}

<div class="trends-container">
    <div class="page-header">
        <h1>Trending Hashtags</h1>
    </div>

    <div class="filter-tabs">
        <a href="/trends?period=hourly" class="filter-tab @(Model.Period == "hourly" ? "active" : "")">Hourly</a>
        <a href="/trends?period=daily" class="filter-tab @(Model.Period == "daily" ? "active" : "")">Daily</a>
        <a href="/trends?period=weekly" class="filter-tab @(Model.Period == "weekly" ? "active" : "")">Weekly</a>
        <a href="/trends" class="filter-tab @(Model.Period == "all" ? "active" : "")">All Time</a>
    </div>

    @if (Model.Hashtags.Any())
    {
        <div class="trends-card-grid">
            @for (var i = 0; i < Model.Hashtags.Count; i++)
            {
                var tag = Model.Hashtags[i];
                <a href="/hashtag/@tag.Tag" class="trend-card">
                    <span class="trend-rank">@(i + 1)</span>
                    <span class="trend-body">
                        <span class="hashtag-name">#@tag.Tag</span>
                        <span class="hashtag-count">@tag.Count post@(tag.Count != 1 ? "s" : "")</span>
                    </span>
                    @if (tag.LastUsed.HasValue)
                    {
                        <span class="trend-time" title="@tag.LastUsed.Value.ToString("u")">@TimeAgo(tag.LastUsed.Value)</span>
                    }
                </a>
            }
        </div>
    }
    else
    {
        @await Html.PartialAsync("../Shared/_EmptyState", new EmptyStateModel
        {
            Title = "No trending hashtags yet",
            Hint = "Hashtags from recent posts will appear here."
        })
    }
</div>

@functions {
    string TimeAgo(DateTime dateTime)
    {
        var span = DateTime.UtcNow - dateTime;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }
}
