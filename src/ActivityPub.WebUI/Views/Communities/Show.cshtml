@model CommunityShowViewModel
@{
    ViewData["Title"] = Model.Community.Name;
    var bannerUrl = Model.Community.Image?.Url ?? "";
    var iconUrl = Model.Community.Icon?.Url ?? "";
}

<div class="page-header">
    <h1>@Model.Community.Name</h1>
    <div class="page-header-actions">
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>

<div class="community-header">
    @if (!string.IsNullOrEmpty(bannerUrl))
    {
        <div class="community-banner" style="background-image: url('@bannerUrl')"></div>
    }
    else
    {
        <div class="community-banner community-banner-default"></div>
    }

    <div class="community-header-body">
        <div class="community-avatar">
            @if (!string.IsNullOrEmpty(iconUrl))
            {
                <img src="@iconUrl" alt="@Model.Community.Name" fetchpriority="high" width="90" height="90" />
            }
            else
            {
                <div class="avatar-placeholder avatar-placeholder-lg">@(Model.Community.Name.FirstOrDefault() != default ? Model.Community.Name.ToString().Substring(0, 1).ToUpperInvariant() : "?")</div>
            }
        </div>

        <div class="community-details">
            @if (!string.IsNullOrEmpty(Model.Community.Summary))
            {
                <p class="community-summary">@Model.Community.Summary</p>
            }
            <p class="card-meta">
                @Model.MemberCount member@(Model.MemberCount == 1 ? "" : "s")
                @if (Model.IsOwner)
                {
                    <span class="badge badge-owner">You are the owner</span>
                }
                else if (Model.IsMember)
                {
                    <span class="badge badge-member">You are a member</span>
                }
            </p>
        </div>

        <div class="community-actions">
            @if (!Model.IsMember)
            {
                <form asp-action="Join" method="post" class="inline-form">
                    <input type="hidden" name="communityId" value="@Model.Community.Id" />
                    <button type="submit" class="btn btn-primary">Join</button>
                </form>
            }
            else if (!Model.IsOwner)
            {
                <form asp-action="Leave" method="post" class="inline-form">
                    <input type="hidden" name="communityId" value="@Model.Community.Id" />
                    <button type="submit" class="btn btn-secondary">Leave</button>
                </form>
            }
            @if (Model.IsOwner)
            {
                <form asp-action="Delete" method="post" class="inline-form"
                      onsubmit="return confirm('Are you sure you want to delete this community?')">
                    <input type="hidden" name="communityId" value="@Model.Community.Id" />
                    <button type="submit" class="btn btn-danger">Delete</button>
                </form>
            }
        </div>
    </div>
</div>

<h2 class="community-members-heading">Members</h2>
<div class="member-list">
    @if (Model.MemberIds.Any())
    {
        @foreach (var memberId in Model.MemberIds)
        {
            var memberName = memberId.Split('/').Last();
            <div class="member-item">
                <a asp-controller="Profile" asp-action="Index" asp-route-username="@memberName">@memberName</a>
            </div>
        }
    }
    else
    {
        <p class="empty-state">No members yet.</p>
    }
</div>
