@model MyCommunitiesViewModel
@{
    ViewData["Title"] = "My Communities";
}

<div class="page-header">
    <h1>My Communities</h1>
    <a asp-action="Index" class="btn btn-secondary">All Communities</a>
</div>

@if (Model.Communities.Any())
{
    <div class="card-grid">
        @foreach (var community in Model.Communities)
        {
            <div class="card">
                <div class="card-header">
                    <a asp-action="Show" asp-route-communityId="@community.Id" class="card-title">@community.Name</a>
                    @if (community.IsOwner)
                    {
                        <span class="badge badge-owner">Owner</span>
                    }
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(community.Summary))
                    {
                        <p class="card-summary">@community.Summary</p>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <p>You are not a member of any communities yet.</p>
        <a asp-action="Index" class="btn btn-primary">Browse Communities</a>
    </div>
}
