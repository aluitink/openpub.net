@model CommunitiesIndexViewModel
@{
    ViewData["Title"] = "Communities";
}

<div class="page-header">
    <h1>Communities</h1>
    <a asp-action="Create" class="btn btn-primary">Create Community</a>
    <a asp-action="MyCommunities" class="btn btn-secondary">My Communities</a>
    <form asp-action="Search" method="get" class="search-form">
        <input type="text" name="q" placeholder="Search communities..." class="search-input" />
        <button type="submit" class="btn btn-secondary">Search</button>
    </form>
</div>

@if (Model.Communities.Any())
{
    <div class="card-grid">
        @foreach (var community in Model.Communities)
        {
            <div class="card">
                <div class="card-header">
                    <a asp-action="Show" asp-route-communityId="@community.Id" class="card-title">@community.Name</a>
                    @if (community.IsOwner)
                    {
                        <span class="badge badge-owner">Owner</span>
                    }
                    @if (community.IsMember && !community.IsOwner)
                    {
                        <span class="badge badge-member">Member</span>
                    }
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(community.Summary))
                    {
                        <p class="card-summary">@community.Summary</p>
                    }
                    <p class="card-meta">@community.MemberCount member(s)</p>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <p>No communities yet. Be the first to create one!</p>
    </div>
}
