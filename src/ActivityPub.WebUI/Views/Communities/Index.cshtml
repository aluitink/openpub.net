@model CommunitiesIndexViewModel
@{
    ViewData["Title"] = "Communities";
}

<div class="page-header">
    <h1>Communities</h1>
    <div class="page-header-actions">
        <form asp-action="Search" method="get" class="search-form">
            <input type="text" name="q" placeholder="Search communities..." class="search-input" />
            <button type="submit" class="btn btn-secondary">Search</button>
        </form>
        <a asp-action="MyCommunities" class="btn btn-secondary">My Communities</a>
        <a asp-action="Create" class="btn btn-primary">Create Community</a>
    </div>
</div>

@if (Model.Communities.Any())
{
    <div class="card-grid">
        @foreach (var community in Model.Communities)
        {
            <div class="card community-card">
                @if (!string.IsNullOrEmpty(community.BannerUrl))
                {
                    <div class="community-card-banner" style="background-image: url('@community.BannerUrl')"></div>
                }
                else
                {
                    <div class="community-card-banner community-card-banner-default"></div>
                }
                <div class="community-card-body">
                    <div class="community-card-icon">
                        @if (!string.IsNullOrEmpty(community.IconUrl))
                        {
                            <img src="@community.IconUrl" alt="@community.Name" loading="lazy" width="48" height="48" />
                        }
                        else
                        {
                            <div class="avatar-placeholder community-avatar-placeholder">@(community.Name.FirstOrDefault() != default ? community.Name.ToString().Substring(0, 1).ToUpperInvariant() : "?")</div>
                        }
                    </div>
                    <div class="community-card-info">
                        <a href="/communities/show?communityId=@Uri.EscapeDataString(community.Id)" class="card-title">@community.Name</a>
                        @if (!string.IsNullOrEmpty(community.Summary))
                        {
                            <p class="card-summary">@community.Summary</p>
                        }
                    </div>
                    <div class="community-card-footer">
                        <span class="card-meta">@community.MemberCount member@(community.MemberCount == 1 ? "" : "s")</span>
                        @if (community.IsOwner)
                        {
                            <span class="badge badge-owner">Owner</span>
                        }
                        @if (community.IsMember && !community.IsOwner)
                        {
                            <span class="badge badge-member">Member</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <p>No communities yet. Be the first to create one!</p>
    </div>
}
