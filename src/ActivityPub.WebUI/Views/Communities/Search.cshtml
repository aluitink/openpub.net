@model SearchCommunitiesViewModel
@{
    ViewData["Title"] = $"Search: {Model.Query}";
}

<div class="page-header">
    <h1>Search: "@Model.Query"</h1>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>

@if (Model.Communities.Any())
{
    <div class="card-grid">
        @foreach (var community in Model.Communities)
        {
            <div class="card">
                <div class="card-header">
                    <a asp-action="Show" asp-route-communityId="@community.Id" class="card-title">@community.Name</a>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(community.Summary))
                    {
                        <p class="card-summary">@community.Summary</p>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="empty-state">
        <p>No communities found matching "@Model.Query".</p>
    </div>
}
