@{
    ViewData["Title"] = "Search";
}
@model SearchViewModel

<div class="search-container">
    <div class="page-header">
        <h1>Search</h1>
    </div>
    <form method="get" class="search-form" id="search-form">
        <input type="text" name="q" id="search-input" value="@Html.Encode(Model.Query)" placeholder="Search notes and users..." class="search-input" autofocus />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
    <div id="search-loading" class="search-loading" style="display:none">Searching…</div>

    @if (string.IsNullOrWhiteSpace(Model.Query))
    {
        <div class="search-empty search-empty-prompt">
            <p class="search-empty-title">Search the fediverse</p>
            <p class="search-empty-hint">Try a hashtag like <a href="/hashtag/dotnet">#dotnet</a>, a username, or any keyword.</p>
        </div>
    }
    else
    {
        <div class="search-tabs">
            <a href="/search?q=@Uri.EscapeDataString(Model.Query)&amp;tab=all" class="search-tab @(Model.Tab == "all" ? "active" : "")">All</a>
            <a href="/search?q=@Uri.EscapeDataString(Model.Query)&amp;tab=notes" class="search-tab @(Model.Tab == "notes" ? "active" : "")">Notes (@Model.Notes.Count)</a>
            <a href="/search?q=@Uri.EscapeDataString(Model.Query)&amp;tab=users" class="search-tab @(Model.Tab == "users" ? "active" : "")">Users (@Model.Users.Count)</a>
            <a href="/search?q=@Uri.EscapeDataString(Model.Query)&amp;tab=hashtags" class="search-tab @(Model.Tab == "hashtags" ? "active" : "")">Hashtags (@Model.Hashtags.Count)</a>
        </div>

        @if ((Model.Tab == "all" || Model.Tab == "notes") && Model.Notes.Any())
        {
            var noteNextUrl = Model.HasMoreNotes ? Url.Action("Index", new { q = Model.Query, tab = Model.Tab == "all" ? "all" : "notes", page = Model.Page + 1 }) : null;

            <div class="search-results search-notes-results" data-feed data-card-selector=".search-note-card" data-page="@Model.Page" data-next="@noteNextUrl">
                @foreach (var note in Model.Notes)
                {
                    <div class="search-note-card" data-activity-id="@note.ActivityId">
                        <div class="search-note-author">
                            <a asp-controller="Profile" asp-action="Index" asp-route-username="@note.AuthorUsername">@note.AuthorName</a>
                            <span class="search-note-username">@note.AuthorUsername</span>
                        </div>
                        <p class="search-note-content">@note.Content</p>
                        <span class="search-note-time">@TimeAgo(note.Published)</span>
                    </div>
                }
            </div>

            @if (Model.HasMoreNotes)
            {
                <div class="load-more-container" data-page="@Model.Page" data-next="@noteNextUrl">
                    <a href="@noteNextUrl" class="btn btn-secondary load-more-btn" role="button">Load more</a>
                </div>
                <div id="load-more-skeleton" class="timeline-loading" aria-hidden="true">
                    <div class="skeleton-note-card">
                        <div class="skeleton-row">
                            <div class="skeleton skeleton-avatar"></div>
                            <div>
                                <div class="skeleton skeleton-line short"></div>
                                <div class="skeleton skeleton-line medium thin"></div>
                            </div>
                        </div>
                        <div class="skeleton skeleton-line long"></div>
                        <div class="skeleton skeleton-line medium"></div>
                    </div>
                </div>
            }
        }
        else if (Model.Tab == "notes" && !Model.Notes.Any())
        {
            <div class="search-empty">
                <p>No notes found matching "@Model.Query"</p>
            </div>
        }

        @if ((Model.Tab == "all" || Model.Tab == "users") && Model.Users.Any())
        {
            <div class="search-results">
                @foreach (var user in Model.Users)
                {
                    <div class="search-user-card">
                        <div class="search-user-avatar">
                            @if (!string.IsNullOrEmpty(user.AvatarUrl))
                            {
                                <img src="@user.AvatarUrl" alt="@user.DisplayName" loading="lazy" width="40" height="40" />
                            }
                            else
                            {
                                <div class="avatar-placeholder">@(user.DisplayName.FirstOrDefault() != default ? user.DisplayName.Substring(0, 1).ToUpperInvariant() : "?")</div>
                            }
                        </div>
                        <div class="search-user-info">
                            <a asp-controller="Profile" asp-action="Index" asp-route-username="@user.Username">
                                <strong>@user.DisplayName</strong>
                                <span class="search-user-username">@user.Username</span>
                            </a>
                            @if (!string.IsNullOrEmpty(user.Bio))
                            {
                                <p class="search-user-bio">@Truncate(user.Bio, 100)</p>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (Model.Tab == "users" && !Model.Users.Any())
        {
            <div class="search-empty">
                <p>No users found matching "@Model.Query"</p>
            </div>
        }

        @if ((Model.Tab == "all" || Model.Tab == "hashtags") && Model.Hashtags.Any())
        {
            <div class="search-results">
                <h3 class="search-section-header">Hashtags</h3>
                @foreach (var tag in Model.Hashtags)
                {
                    <a href="/hashtag/@Uri.EscapeDataString(tag.Tag)" class="search-hashtag-card">
                        <span class="search-hashtag-tag">#@tag.Tag</span>
                        <span class="search-hashtag-count">@tag.Count note@(tag.Count == 1 ? "" : "s")</span>
                    </a>
                }
            </div>
        }
        else if (Model.Tab == "hashtags" && !Model.Hashtags.Any())
        {
            <div class="search-empty">
                <p>No hashtags found matching "@Model.Query"</p>
            </div>
        }
    }
</div>

@section Scripts {
    <script src="~/js/search.js" asp-append-version="true"></script>
}

@functions {
    string TimeAgo(DateTime dateTime)
    {
        var span = DateTime.UtcNow - dateTime;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }

    string Truncate(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Length <= maxLength ? text : text.Substring(0, maxLength) + "...";
    }
}
