@model ActivityPub.WebUI.Models.RegisterModel

@{
    ViewData["Title"] = "Register";
}

<h2>Create an account</h2>

<form asp-action="Register" method="post" class="auth-form">
    <div asp-validation-summary="All" class="validation-summary"></div>

    <div class="form-group">
        <label asp-for="Username">Username</label>
        <input asp-for="Username" class="form-control" placeholder="Choose a username" />
        <span asp-validation-for="Username" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="DisplayName">Display Name</label>
        <input asp-for="DisplayName" class="form-control" placeholder="Your display name" />
        <span asp-validation-for="DisplayName" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" class="form-control" placeholder="your@email.com" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password">Password</label>
        <input asp-for="Password" type="password" class="form-control" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="ConfirmPassword">Confirm Password</label>
        <input asp-for="ConfirmPassword" type="password" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Register</button>
</form>

<p class="auth-link">Already have an account? <a asp-action="Login">Login here</a></p>
