@model ActivityPub.WebUI.Models.LoginModel

@{
    ViewData["Title"] = "Login";
}

<h2>Login</h2>

<form asp-action="Login" method="post" class="auth-form">
    <div asp-validation-summary="All" class="validation-summary"></div>
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

    <div class="form-group">
        <label asp-for="Username">Username</label>
        <input asp-for="Username" class="form-control" />
        <span asp-validation-for="Username" class="field-error"></span>
    </div>

    <div class="form-group">
        <label asp-for="Password">Password</label>
        <input asp-for="Password" type="password" class="form-control" />
        <span asp-validation-for="Password" class="field-error"></span>
    </div>

    <div class="form-group checkbox-group">
        <label>
            <input asp-for="RememberMe" /> Remember me
        </label>
    </div>

    <button type="submit" class="btn btn-primary btn-block">Login</button>
</form>

<p class="auth-link">Don't have an account? <a asp-action="Register">Register here</a></p>
