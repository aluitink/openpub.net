@{
    var controller = (ViewData["Controller"] as string) ?? "";
    var action = (ViewData["Action"] as string) ?? "";

    bool NavActive(string ctrl, params string[] actions)
        => controller.Equals(ctrl, StringComparison.OrdinalIgnoreCase)
           && (actions.Length == 0 || actions.Any(a => a.Equals(action, StringComparison.OrdinalIgnoreCase)));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fediblog</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body class="page-@ViewData["PageClass"]" data-current-user="@(User.Identity?.IsAuthenticated == true ? User.Identity.Name : "")">
    <header>
        <nav class="navbar" aria-label="Main">
            <div class="nav-container">
                <div class="nav-left">
                    <button type="button" class="nav-hamburger" id="nav-hamburger" aria-label="Open menu" aria-controls="nav-menu" aria-expanded="false">
                        <span class="hamburger-bar"></span>
                        <span class="hamburger-bar"></span>
                        <span class="hamburger-bar"></span>
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="brand">Fediblog</a>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <form asp-controller="Search" asp-action="Index" method="get" class="nav-search-form" role="search">
                            <input type="text" name="q" id="nav-search-input" class="nav-search-input" placeholder="Search… (press /)" aria-label="Search" />
                        </form>
                        <button type="button" class="palette-trigger" id="palette-trigger" aria-label="Open command palette" aria-controls="palette-overlay" aria-expanded="false" title="Command palette (Ctrl+K)">
                            <span class="palette-trigger-icon"><icon name="search" /></span>
                            <span class="palette-trigger-kbd" aria-hidden="true">Ctrl K</span>
                        </button>
                    }
                </div>
                <ul class="nav-menu" id="nav-menu">
                    <li class="nav-item">
                        <button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle dark mode">
                            <span class="theme-toggle-icon" id="theme-toggle-icon"><icon name="moon" /></span>
                        </button>
                    </li>
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <li class="nav-item">
                            <a asp-controller="Timeline" asp-action="Index" class="nav-link@(NavActive("Timeline") ? " active" : "")">Timeline</a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Compose" asp-action="Index" class="nav-link@(NavActive("Compose") ? " active" : "")">Compose</a>
                        </li>
                        <li class="nav-group">
                            <button type="button" class="nav-group-toggle" id="nav-toggle-notifications" aria-controls="nav-menu-notifications" aria-expanded="false" aria-haspopup="menu">
                                Notifications
                                <span id="notification-badge" class="notification-badge" style="display:none">0</span>
                                <span class="caret"><icon name="caret" /></span>
                            </button>
                            <ul id="nav-menu-notifications" class="nav-dropdown" role="menu" aria-labelledby="nav-toggle-notifications">
                                <li><a asp-controller="Notifications" asp-action="Index" class="nav-dropdown-link@(NavActive("Notifications") ? " active" : "")" role="menuitem">Inbox</a></li>
                            </ul>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Search" asp-action="Index" class="nav-link@(NavActive("Search") ? " active" : "")">Search</a>
                        </li>
                        <li class="nav-group">
                            <button type="button" class="nav-group-toggle" id="nav-toggle-discover" aria-controls="nav-menu-discover" aria-expanded="false" aria-haspopup="menu">
                                Discover <span class="caret"><icon name="caret" /></span>
                            </button>
                            <ul id="nav-menu-discover" class="nav-dropdown" role="menu" aria-labelledby="nav-toggle-discover">
                                <li><a asp-controller="Trends" asp-action="Index" class="nav-dropdown-link@(NavActive("Trends", "Trending") ? " active" : "")" role="menuitem">Trends</a></li>
                                <li><a asp-controller="Suggestions" asp-action="Index" class="nav-dropdown-link@(NavActive("Suggestions", "Discover") ? " active" : "")" role="menuitem">Suggestions</a></li>
                                <li><a asp-controller="Communities" asp-action="Index" class="nav-dropdown-link@(NavActive("Communities") ? " active" : "")" role="menuitem">Communities</a></li>
                            </ul>
                        </li>
                        <li class="nav-group">
                            <button type="button" class="nav-group-toggle" id="nav-toggle-account" aria-controls="nav-menu-account" aria-expanded="false" aria-haspopup="menu">
                                Account <span class="caret"><icon name="caret" /></span>
                            </button>
                            <ul id="nav-menu-account" class="nav-dropdown" role="menu" aria-labelledby="nav-toggle-account">
                                <li><a asp-controller="Profile" asp-action="Index" class="nav-dropdown-link@(NavActive("Profile", "Index") ? " active" : "")" role="menuitem">Profile</a></li>
                                <li><a asp-controller="Profile" asp-action="Edit" class="nav-dropdown-link@(NavActive("Profile", "Edit") ? " active" : "")" role="menuitem">Edit Profile</a></li>
                                <li><a asp-controller="Follow" asp-action="Index" class="nav-dropdown-link@(NavActive("Follow", "Index") ? " active" : "")" role="menuitem">Follow</a></li>
                                <li><a asp-controller="Follow" asp-action="Following" class="nav-dropdown-link@(NavActive("Follow", "Following") ? " active" : "")" role="menuitem">Following</a></li>
                                <li><a asp-controller="Follow" asp-action="Followers" class="nav-dropdown-link@(NavActive("Follow", "Followers") ? " active" : "")" role="menuitem">Followers</a></li>
                                <li><a asp-controller="Poll" asp-action="New" class="nav-dropdown-link@(NavActive("Poll") ? " active" : "")" role="menuitem">New Poll</a></li>
                                <li><a asp-controller="Settings" asp-action="Index" class="nav-dropdown-link@(NavActive("Settings") ? " active" : "")" role="menuitem">Settings</a></li>
                            </ul>
                        </li>
                        <li class="nav-item nav-item-user">
                            <span class="user-greeting">Hello, @User.Identity.Name</span>
                            <form asp-controller="Auth" asp-action="Logout" method="post" class="inline-form">
                                <button type="submit" class="btn btn-secondary">Logout</button>
                            </form>
                        </li>
                        @await Component.InvokeAsync("AdminSection")
                    }
                    else
                    {
                        <li class="nav-item"><a asp-controller="Auth" asp-action="Login" class="btn btn-secondary">Login</a></li>
                        <li class="nav-item"><a asp-controller="Auth" asp-action="Register" class="btn btn-primary">Register</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>
    <div class="nav-scrim" id="nav-scrim" aria-hidden="true"></div>
    <div class="main-container">
        <main>
            @RenderBody()
        </main>
    </div>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <a asp-controller="Compose" asp-action="Index" class="compose-fab" aria-label="Compose new post">+</a>
        <nav class="mobile-bottom-nav" aria-label="Primary">
            <ul>
                <li><a asp-controller="Timeline" asp-action="Index" class="@(NavActive("Timeline") ? "active" : "")"><span class="mbn-icon"><icon name="home" /></span>Home</a></li>
                <li><a asp-controller="Search" asp-action="Index" class="@(NavActive("Search") ? "active" : "")"><span class="mbn-icon"><icon name="search" /></span>Search</a></li>
                <li><a asp-controller="Notifications" asp-action="Index" class="@(NavActive("Notifications") ? "active" : "")"><span class="mbn-icon"><icon name="inbox" /></span>Inbox</a></li>
                <li><a asp-controller="Profile" asp-action="Index" class="@(NavActive("Profile") ? "active" : "")"><span class="mbn-icon"><icon name="profile" /></span>Profile</a></li>
            </ul>
        </nav>
    }
    <footer>
        <div class="footer-container">
            <div class="footer-tagline">
                Fediblog &mdash; a federated microblogging platform powered by ActivityPub.NET
            </div>
            <nav class="footer-links" aria-label="Footer">
                <a asp-controller="Home" asp-action="About">About</a>
                <a asp-controller="Trends" asp-action="Index">Trending</a>
                <a asp-controller="Communities" asp-action="Index">Communities</a>
                <a asp-controller="Home" asp-action="Index">Home</a>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a asp-controller="FederationHealth" asp-action="Index">Server health</a>
                }
            </nav>
        </div>
    </footer>
    <div id="toast-container" class="toast-container" aria-live="polite" role="status" aria-atomic="true"></div>
    <div class="lightbox-overlay" id="lightbox-overlay" hidden aria-hidden="true">
        <div class="lightbox-dialog" role="dialog" aria-modal="true" aria-label="Image viewer" aria-hidden="true">
            <button type="button" class="lightbox-close" data-lightbox-close aria-label="Close image viewer"><icon name="close" /></button>
            <button type="button" class="lightbox-nav lightbox-prev" data-lightbox-prev aria-label="Previous image"><icon name="prev" /></button>
            <img class="lightbox-img" id="lightbox-img" src="" alt="" />
            <button type="button" class="lightbox-nav lightbox-next" data-lightbox-next aria-label="Next image"><icon name="next" /></button>
            <div class="lightbox-cw-gate" id="lightbox-cw-gate" hidden>
                <span class="lightbox-cw-label"><icon name="warning" /></span>
                <span class="lightbox-cw-text">This image is marked sensitive. Tap to reveal.</span>
                <button type="button" class="lightbox-cw-reveal" data-lightbox-cw-reveal>Reveal</button>
            </div>
            <div class="lightbox-counter" id="lightbox-counter" aria-live="polite"></div>
        </div>
    </div>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <div class="palette-overlay" id="palette-overlay" hidden aria-hidden="true">
            <div class="palette-dialog" role="dialog" aria-modal="true" aria-label="Command palette" aria-hidden="true">
                <div class="palette-input-row">
                    <span class="palette-search-icon"><icon name="search" /></span>
                    <input type="text" id="palette-input" class="palette-input" placeholder="Search notes, people, hashtags, communities…" aria-label="Command palette search" autocomplete="off" spellcheck="false" />
                    <kbd class="palette-esc-hint" aria-hidden="true">esc</kbd>
                </div>
                <div class="palette-results" id="palette-results" role="listbox" tabindex="-1" aria-label="Search results">
                    <div class="palette-empty" id="palette-empty">Type to search across the fediverse.</div>
                </div>
                <div class="palette-footer" aria-hidden="true">
                    <span><kbd>&#8593;&#8595;</kbd> navigate</span>
                    <span><kbd>enter</kbd> select</span>
                    <span><kbd>esc</kbd> close</span>
                </div>
            </div>
        </div>
    }
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/lightbox.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <script src="https://cdn.jsdelivr.net/npm/%40microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
        <script src="~/js/menu.js" asp-append-version="true"></script>
        <script src="~/js/palette.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
