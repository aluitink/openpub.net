@model PollComposeModel
@{
    ViewData["Title"] = "Create Poll";
}

<h2>Create Poll</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Question</label>
        <textarea name="Content" class="form-control" rows="2" maxlength="500">@Model.Content</textarea>
        <small class="text-muted">1-500 characters</small>
    </div>

    <div class="mb-3">
        <label class="form-label">Options</label>
        @for (int i = 0; i < 4; i++)
        {
            <input type="text" name="Options" class="form-control mb-2" placeholder="Option @(i+1)" value="@Model.Options?[i]" maxlength="50" />
        }
        <small class="text-muted">2-4 options, max 50 characters each</small>
    </div>

    <div class="mb-3">
        <label class="form-label">Duration (minutes)</label>
        <input type="number" name="DurationMinutes" class="form-control" value="@Model.DurationMinutes" min="5" max="10080" />
        <small class="text-muted">5 minutes to 1 week</small>
    </div>

    <button type="submit" class="btn btn-primary">Post Poll</button>
    <a asp-controller="Timeline" asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
