@model ActivityPub.WebUI.Controllers.SuggestionsViewModel
@{
    ViewData["Title"] = "Discover";
}

<div class="discover-container">
    <div class="page-header">
        <h1>Discover People</h1>
    </div>

    <div class="section">
        <h2>Suggested for you</h2>

        @if (Model.Suggestions.Any())
        {
            <div class="suggestions-grid">
                @foreach (var s in Model.Suggestions)
                {
                    <div class="suggestion-card">
                        <div class="suggestion-avatar">
                            @if (!string.IsNullOrEmpty(s.AvatarUrl))
                            {
                                <img src="@s.AvatarUrl" alt="@s.DisplayName" loading="lazy" width="40" height="40" />
                            }
                            else
                            {
                                <div class="avatar-placeholder">@((s.DisplayName ?? s.Username).FirstOrDefault() != default ? (s.DisplayName ?? s.Username).ToString()!.Substring(0, 1).ToUpperInvariant() : "?")</div>
                            }
                        </div>
                        <div class="suggestion-info">
                            <a href="/Profile?username=@s.Username" class="display-name">@s.DisplayName</a>
                            <span class="username">@s.Username</span>
                            @if (!string.IsNullOrEmpty(s.Bio))
                            {
                                <p class="bio">@s.Bio</p>
                            }
                            <span class="follower-count">@s.Followers follower@(s.Followers != 1 ? "s" : "")</span>
                        </div>
                        <div class="suggestion-actions">
                            <form method="post" asp-controller="Suggestions" asp-action="UnmuteUser" asp-route-userId="@s.ActorId">
                                <button type="submit" class="btn-follow">Follow</button>
                            </form>
                            <form method="post" asp-controller="Suggestions" asp-action="MuteUser" asp-route-userId="@s.ActorId">
                                <button type="submit" class="btn-muted">Mute</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="empty-state">No suggestions yet. Follow some people to get started!</p>
        }
    </div>

    <div class="section">
        <h2>Content Filters</h2>

        @if (Model.ContentFilters.Any())
        {
            <ul class="filter-list">
                @foreach (var filter in Model.ContentFilters)
                {
                    <li>
                        <span class="filter-keyword">@filter</span>
                        <button type="button" class="btn-remove-filter" data-filter="@filter">Remove</button>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="empty-state">No content filters configured.</p>
        }

        <div class="add-filter-form">
            <input type="text" id="filterInput" placeholder="Add keyword to filter..." aria-label="Keyword to filter" maxlength="50" />
            <button type="button" class="btn-add-filter" id="add-filter-btn">Add Filter</button>
        </div>
    </div>
</div>

<script src="~/js/suggestions.js" asp-append-version="true"></script>
