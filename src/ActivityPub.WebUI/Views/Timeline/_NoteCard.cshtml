@model TimelineActivityItem

@{
    string TimeAgo(DateTime dateTime)
    {
        var diff = DateTime.UtcNow - dateTime;
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        return $"{(int)diff.TotalDays}d ago";
    }
}

<div class="note-card@(Model.InReplyTo != null ? " note-reply" : "")">
    @if (Model.ActivityType == "Announce")
    {
        <div class="boost-banner">Boosted by @Model.AuthorName</div>
    }

    <div class="note-header">
        <div class="note-avatar">
            @if (!string.IsNullOrEmpty(Model.AuthorAvatarUrl))
            {
                <img src="@Model.AuthorAvatarUrl" alt="@Model.AuthorName" loading="lazy" />
            }
            else
            {
                <div class="avatar-placeholder">@((Model.AuthorDisplayName ?? Model.AuthorName).FirstOrDefault() != default ? (Model.AuthorDisplayName ?? Model.AuthorName).ToString()!.Substring(0, 1).ToUpperInvariant() : "?")</div>
            }
        </div>
        <div class="note-author">
            <a class="note-display-name" href="/actors/@Model.AuthorName">@Html.Raw(Model.AuthorDisplayName)</a>
            <span class="note-username">@Model.AuthorName</span>
        </div>
        <span class="note-timestamp" title="@Model.Published.ToUniversalTime().ToString("yyyy-MM-dd HH:mm:ss") + " UTC" data-published="@Model.Published.ToUniversalTime().ToString("o")">@TimeAgo(Model.Published)</span>
    </div>

    @if (Model.InReplyTo != null)
    {
        <div class="reply-indicator">↩ Reply</div>
    }

    @if (Model.Sensitive || !string.IsNullOrEmpty(Model.ContentWarning))
    {
        <div class="cw-banner">
            <span class="cw-label">&#9888; @(Model.ContentWarning ?? "Content Warning")</span>
            <button type="button" class="cw-toggle-btn" aria-expanded="false">Show</button>
        </div>
    }

    <div class="note-content@(Model.Sensitive && string.IsNullOrEmpty(Model.ContentWarning) ? " note-content-blurred" : "")"@((Model.Sensitive || !string.IsNullOrEmpty(Model.ContentWarning)) ? " data-cw-content" : "")>@Html.Raw(Model.Content)</div>

    @if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        <div class="note-attachment@(Model.Sensitive ? " note-attachment-blurred" : "")"@((Model.Sensitive || !string.IsNullOrEmpty(Model.ContentWarning)) ? " data-cw-content" : "")>
            <img src="@Model.ImageUrl" alt="Attached image" class="note-image" loading="lazy" />
        </div>
    }

    @if (Model.DocumentAttachments != null && Model.DocumentAttachments.Count > 0)
    {
        <div class="note-attachments">
            @foreach (var doc in Model.DocumentAttachments)
            {
                <a href="@doc.Url" download class="doc-attachment">
                    <span class="doc-icon">&#128196;</span>
                    <span class="doc-name">@(string.IsNullOrEmpty(doc.Name) ? "Download" : doc.Name)</span>
                </a>
            }
        </div>
    }

    @if (Model.PollQuestion != null)
    {
        <div class="poll-widget">
            <div class="poll-question">@Html.Raw(Model.PollQuestion)</div>
            @if (Model.PollOptions != null)
            {
                @foreach (var opt in Model.PollOptions)
                {
                    <div class="poll-option">
                        <div class="poll-bar" style="width:@opt.Percent%">@opt.Text</div>
                        <span class="poll-votes">@(opt.Votes ?? 0) votes</span>
                    </div>
                }
            }
            @if (Model.PollEndTime.HasValue)
            {
                <div class="poll-timer">
                    @(Math.Max(0, (Model.PollEndTime.Value - DateTime.UtcNow).TotalMinutes) > 0
                        ? $"{(int)Math.Max(0, (Model.PollEndTime.Value - DateTime.UtcNow).TotalMinutes)} minutes left"
                        : "Expired")
                </div>
            }
            @if (Model.ActivityId != null)
            {
                <form asp-controller="Poll" asp-action="Vote" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="pollId" value="@Model.PollId" />
                    <input type="hidden" name="activityId" value="@Model.ActivityId" />
                    <button type="submit" name="optionIndex" value="0" class="btn btn-sm btn-outline-primary">Vote</button>
                </form>
            }
        </div>
    }

    <div class="note-actions">
        <form asp-controller="Interaction" asp-action="@(Model.IsLiked ? "Unlike" : "Like")" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="targetActivityId" value="@Model.ActivityId" />
            <button type="submit" class="btn-action btn-like@(Model.IsLiked ? " active" : "")" title="Like">♥ @Model.LikeCount</button>
        </form>

        <form asp-controller="Interaction" asp-action="@(Model.IsBoosted ? "Unboost" : "Boost")" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="targetActivityId" value="@Model.ActivityId" />
            <button type="submit" class="btn-action btn-boost@(Model.IsBoosted ? " active" : "")" title="Boost">↻ @Model.BoostCount</button>
        </form>

        <button type="button" class="btn-action btn-reply" data-reply-target="reply-@Model.ActivityId">💬 @Model.ReplyCount</button>

        <div class="note-more-menu">
            <button type="button" class="btn-action btn-more" title="More actions" aria-label="More actions" aria-haspopup="true" aria-expanded="false">&#8943;</button>
            <div class="note-more-dropdown" role="menu">
                <button type="button" class="note-more-item" data-action="copy-link" data-url="@Url.Action("Show", "Timeline", new { id = Model.ActivityId })" role="menuitem">Copy link</button>
                <a asp-controller="Compose" asp-action="Index" asp-route-replyTo="@Model.ActivityId" class="note-more-item" role="menuitem">Reply via Compose</a>
                <form asp-controller="Compose" asp-action="EditNote" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ActivityId" value="@Model.ActivityId" />
                    <input type="hidden" name="Content" value="@Model.Content" />
                    <button type="submit" class="note-more-item" role="menuitem">Edit</button>
                </form>
                <form asp-controller="Compose" asp-action="Delete" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="activityId" value="@Model.ActivityId" />
                    <button type="submit" class="note-more-item note-more-danger" role="menuitem">Delete</button>
                </form>
                <a asp-controller="Report" asp-action="Form" asp-route-targetUsername="@Model.AuthorName" asp-route-activityId="@Model.ActivityId" class="note-more-item" role="menuitem">Report note</a>
                <a href="/suggestions/mute/@Model.AuthorName" class="note-more-item" role="menuitem">Mute @Model.AuthorName</a>
            </div>
        </div>
    </div>

    <div id="reply-@Model.ActivityId" class="reply-form-container" hidden>
        <div class="reply-context-banner">
            <span class="reply-context-icon">&#8617;</span>
            <span class="reply-context-text">Replying to <strong>@Model.AuthorDisplayName</strong> (@Model.AuthorName)</span>
            <span class="reply-context-snippet">"@(Model.Content.Length > 80 ? Model.Content.Substring(0, 80) + "…" : Model.Content)"</span>
        </div>
        <form asp-controller="Interaction" asp-action="Reply" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="targetActivityId" value="@Model.ActivityId" />
            <textarea name="content" class="form-control reply-textarea" placeholder="Write a reply..." rows="2" maxlength="500"></textarea>
            <div class="reply-actions">
                <button type="submit" class="btn btn-primary">Reply</button>
            </div>
        </form>
    </div>
</div>
