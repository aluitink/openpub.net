@{
    ViewData["Title"] = "Timeline";
}
@model IEnumerable<TimelineActivityItem>

@if (ViewBag.InteractionSuccess != null)
{
    <div class="alert-success">@ViewBag.InteractionSuccess</div>
}

@if (ViewBag.InteractionError != null)
{
    <div class="alert-error">@ViewBag.InteractionError</div>
}

@if (ViewBag.ReplyError != null)
{
    <div class="alert-error">@ViewBag.ReplyError</div>
}

@if (ViewBag.ComposeSuccess != null && (bool)ViewBag.ComposeSuccess)
{
    <div class="alert-success">Post published successfully!</div>
}

<div class="timeline-header">
    <h2>Home Timeline</h2>
    <a asp-controller="Compose" asp-action="Index" class="btn btn-primary">Compose</a>
    <a asp-controller="Compose" asp-action="NewArticle" class="btn btn-secondary">New Article</a>
</div>

@if (Model != null && Model.Any())
{
    var topLevel = Model.Where(x => x.InReplyTo == null).ToList();
    var replies = Model.Where(x => x.InReplyTo != null).ToList();
    var page = (int)(ViewBag.Page ?? 1);
    var hasMore = (bool)(ViewBag.HasMore ?? false);

    <div class="timeline-feed">
        @foreach (var item in topLevel)
        {
            @await Html.PartialAsync("_NoteCard", item)

            @foreach (var reply in replies.Where(r => r.InReplyTo == item.ActivityId))
            {
                @await Html.PartialAsync("_NoteCard", reply)
            }
        }

        @foreach (var orphan in replies.Where(r => topLevel.All(t => t.ActivityId != r.InReplyTo)))
        {
            @await Html.PartialAsync("_NoteCard", orphan)
        }
    </div>

    @if (hasMore)
    {
        <div class="load-more-container">
            <a href="?page=@(page + 1)" class="btn btn-secondary load-more-btn">Load more</a>
        </div>
    }
}
else
{
    <div class="empty-timeline">
        <p>No posts yet. <a asp-controller="Compose" asp-action="Index">Write your first post!</a></p>
    </div>
}

@section Scripts {
<script>
(function() {
    function timeAgo(date) {
        var diff = Date.now() - date.getTime();
        var mins = Math.floor(diff / 60000);
        if (mins < 1) return 'just now';
        if (mins < 60) return mins + 'm ago';
        var hrs = Math.floor(mins / 60);
        if (hrs < 24) return hrs + 'h ago';
        var days = Math.floor(hrs / 24);
        if (days < 30) return days + 'd ago';
        return date.toLocaleDateString();
    }

    function updateTimestamps() {
        document.querySelectorAll('.note-timestamp[data-published]').forEach(function(el) {
            var d = new Date(el.dataset.published);
            el.textContent = timeAgo(d);
        });
    }
    setInterval(updateTimestamps, 60000);

    document.querySelectorAll('.btn-like, .btn-boost').forEach(function(btn) {
        var form = btn.closest('form');
        if (!form) return;
        var origSubmit = form.submit;
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            var countSpan = btn;
            var text = btn.textContent;
            var parts = text.split(/\s+/);
            var count = parseInt(parts[parts.length - 1], 10) || 0;
            var isActive = btn.classList.contains('active');
            var isLike = btn.classList.contains('btn-like');
            var action = isLike ? (isActive ? 'Unlike' : 'Like') : (isActive ? 'Unboost' : 'Boost');
            var newCount = isActive ? count - 1 : count + 1;
            var icon = isLike ? '♥' : '↻';
            btn.textContent = icon + ' ' + newCount;
            if (!isActive) btn.classList.add('active');
            else btn.classList.remove('active');
            var fd = new FormData(form);
            fetch(form.action, { method: 'POST', body: fd, credentials: 'same-origin' })
                .then(function(r) {
                    if (!r.ok) throw new Error('Failed');
                    window.location.reload();
                })
                .catch(function() {
                    btn.textContent = text;
                    if (isActive) btn.classList.add('active');
                    else btn.classList.remove('active');
                });
        });
    });

    document.querySelectorAll('.btn-delete').forEach(function(btn) {
        var form = btn.closest('form');
        if (!form) return;
        form.addEventListener('submit', function(e) {
            if (!confirm('Are you sure you want to delete this post? This cannot be undone.')) {
                e.preventDefault();
            }
        });
    });
})();
</script>
}
