@{
    ViewData["Title"] = "Timeline";
}
@model IEnumerable<TimelineActivityItem>

@if (ViewBag.InteractionSuccess != null)
{
    <div class="alert-success">@ViewBag.InteractionSuccess</div>
}

@if (ViewBag.InteractionError != null)
{
    <div class="alert-error">@ViewBag.InteractionError</div>
}

@if (ViewBag.ReplyError != null)
{
    <div class="alert-error">@ViewBag.ReplyError</div>
}

@if (ViewBag.ComposeSuccess != null && (bool)ViewBag.ComposeSuccess)
{
    <div class="alert-success">Post published successfully!</div>
}

<div class="timeline-header">
    <h2>Home Timeline</h2>
    <a asp-controller="Compose" asp-action="Index" class="btn btn-primary">Compose</a>
    <a asp-controller="Compose" asp-action="NewArticle" class="btn btn-secondary">New Article</a>
</div>

@if (Model != null && Model.Any())
{
    var topLevel = Model.Where(x => x.InReplyTo == null).ToList();
    var replies = Model.Where(x => x.InReplyTo != null).ToList();

    <div class="timeline-feed">
        @foreach (var item in topLevel)
        {
            @await Html.PartialAsync("_NoteCard", item)

            @foreach (var reply in replies.Where(r => r.InReplyTo == item.ActivityId))
            {
                @await Html.PartialAsync("_NoteCard", reply)
            }
        }

        @foreach (var orphan in replies.Where(r => topLevel.All(t => t.ActivityId != r.InReplyTo)))
        {
            @await Html.PartialAsync("_NoteCard", orphan)
        }
    </div>
}
else
{
    <div class="empty-timeline">
        <p>No posts yet. <a asp-controller="Compose" asp-action="Index">Write your first post!</a></p>
    </div>
}
