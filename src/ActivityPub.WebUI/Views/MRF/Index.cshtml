@model MRFViewModel
@{
    ViewData["Title"] = "MRF Settings";
}

<div class="page-header">
    <h1>Moderation Rules Framework (MRF)</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="Update" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <h3>Blocked Domains</h3>
        <div class="input-group mb-2">
            <input type="text" name="NewDomain" class="form-control" placeholder="Add domain to block..." aria-label="Domain to block" value="@Model.NewDomain" />
            <button type="submit" name="action" value="addDomain" class="btn btn-secondary">Add</button>
        </div>
        @if (Model.BlockedDomains.Any())
        {
            <ul class="list-group">
                @foreach (var domain in Model.BlockedDomains)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @domain
                        <button type="submit" name="RemoveDomain" value="@domain" class="btn btn-sm btn-danger">Remove</button>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="mrf-empty">No blocked domains. Content from every domain is currently allowed.</p>
        }
    </div>

    <div class="mb-3">
        <h3>Prohibited Words</h3>
        <div class="input-group mb-2">
            <input type="text" name="NewWord" class="form-control" placeholder="Add prohibited word..." aria-label="Prohibited word" value="@Model.NewWord" />
            <button type="submit" name="action" value="addWord" class="btn btn-secondary">Add</button>
        </div>
        @if (Model.ProhibitedWords.Any())
        {
            <ul class="list-group">
                @foreach (var word in Model.ProhibitedWords)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @word
                        <button type="submit" name="RemoveWord" value="@word" class="btn btn-sm btn-danger">Remove</button>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="mrf-empty">No prohibited words. All content passes the MRF word filter.</p>
        }
    </div>

    <div class="mb-3">
        <label class="form-label">Max Content Length</label>
        <input type="number" name="MaxContentLength" class="form-control" value="@Model.MaxContentLength" min="100" max="100000" />
    </div>

    <input type="hidden" name="BlockedDomains" value="@string.Join(",", Model.BlockedDomains)" />
    <input type="hidden" name="ProhibitedWords" value="@string.Join(",", Model.ProhibitedWords)" />

    <button type="submit" class="btn btn-primary">Save Settings</button>
    <a asp-controller="Admin" asp-action="Moderation" class="btn btn-secondary">Back</a>
</form>
