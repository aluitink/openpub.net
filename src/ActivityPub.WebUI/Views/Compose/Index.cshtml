@{
    ViewData["Title"] = "Compose";
}
@model ComposeModel

<div class="compose-container">
    <h2>Compose New Post</h2>

    <form asp-action="Post" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="compose-form">
            <div class="form-group">
                <label for="Content">What's on your mind?</label>
                <textarea
                    id="Content"
                    name="Content"
                    class="form-control compose-textarea"
                    rows="5"
                    maxlength="500"
                    placeholder="Write your post... (max 500 characters)">@Model?.Content</textarea>
                <span class="char-counter"><span id="charCount">0</span>/500</span>
            </div>

            <div class="form-group">
                <label for="Image">Attach Image (max 10MB)</label>
                <input type="file" name="Image" id="Image" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" />
            </div>

            <div class="form-group">
                <label for="Document">Attach Document (PDF, max 20MB)</label>
                <input type="file" name="Document" id="Document" class="form-control" accept="application/pdf" />
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-error">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <button type="submit" class="btn btn-primary btn-block">Post</button>
        </div>
    </form>
</div>

<script>
    (function() {
        var textarea = document.getElementById('Content');
        var counter = document.getElementById('charCount');
        var max = 500;
        if (!textarea || !counter) return;
        function update() {
            var len = textarea.value.length;
            counter.textContent = len;
            var parent = counter.closest('.char-counter');
            if (!parent) return;
            parent.classList.remove('char-ok', 'char-near', 'char-over');
            if (len > max) parent.classList.add('char-over');
            else if (len > max * 0.9) parent.classList.add('char-near');
            else parent.classList.add('char-ok');
        }
        update();
        textarea.addEventListener('input', update);
    })();
</script>
