@model ComposeIndexViewModel
@{
    var isReply = Model.ReplyTarget != null;
    var _placeholderLabel = isReply ? "Write your reply..." : "What's on your mind?";
    var _placeholder = isReply ? "Write your reply... (max 500 characters)" : "What's on your mind (max 500 characters)";
    ViewData["Title"] = isReply ? "Reply" : "Compose";
}

<div class="compose-container">
    <div class="page-header">
        <h1>@(isReply ? "Reply" : "Compose New Post")</h1>
        @if (Model.ReplyTarget != null)
        {
            <div class="page-header-actions">
                <a asp-action="Index" class="btn btn-secondary btn-sm reply-cancel-link">Cancel reply</a>
            </div>
        }
    </div>

    <form asp-action="Post" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @if (Model.ReplyTarget != null)
        {
            <input type="hidden" name="InReplyTo" value="@Model.ReplyTarget.ActivityId" />
        }

        <div class="compose-form">
            @if (Model.ReplyTarget != null)
            {
                <div class="reply-context-banner">
                    <span class="reply-context-icon">&#8617;</span>
                    <span class="reply-context-text">Replying to <a href="/actors/@Model.ReplyTarget.AuthorName"><strong>@Model.ReplyTarget.AuthorDisplayName</strong></a> (@Model.ReplyTarget.AuthorName)</span>
                    @if (!string.IsNullOrEmpty(Model.ReplyTarget.Snippet))
                    {
                        var snippet = Model.ReplyTarget.Snippet;
                        <span class="reply-context-snippet">"@(snippet.Length > 80 ? snippet.Substring(0, 80) + "…" : snippet)"</span>
                    }
                </div>
            }

            <div class="form-group">
                <label for="Content">@_placeholderLabel</label>
                <textarea
                    id="Content"
                    name="Content"
                    class="form-control compose-textarea"
                    rows="5"
                    maxlength="500"
                    placeholder="@_placeholder">@Model.Compose?.Content</textarea>
                <span class="char-counter char-ok" data-states="char-ok char-near char-over"><span id="charCount">0</span>/500</span>
                <div id="compose-preview" class="compose-preview" style="display:none"></div>
            </div>

            @if (Model.ReplyTarget == null)
            {
                <div class="form-group">
                    <label for="Image">Attach Image (max 10MB)</label>
                    <input type="file" name="Image" id="Image" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" />
                    <div id="image-preview-container" class="image-preview-container" style="display:none">
                        <img id="image-preview" class="image-preview" alt="Preview" />
                        <button type="button" id="image-remove" class="image-remove-btn" title="Remove image">&#10005; Remove</button>
                    </div>
                </div>

                <div class="form-group">
                    <label for="Document">Attach Document (PDF, max 20MB)</label>
                    <input type="file" name="Document" id="Document" class="form-control" accept="application/pdf" />
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-error">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <button type="submit" class="btn btn-primary btn-block">@(Model.ReplyTarget != null ? "Reply" : "Post")</button>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/menu.js" asp-append-version="true"></script>
    <script src="~/js/compose.js" asp-append-version="true"></script>
}
