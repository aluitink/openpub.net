@{
    ViewData["Title"] = $"#{Model.Tag}";
}
@model HashtagViewModel

<div class="hashtag-container">
    <div class="page-header">
        <h1 class="hashtag-header">
            <a href="/hashtag/@Uri.EscapeDataString(Model.Tag.TrimStart('#'))" class="hashtag-link">@Model.Tag</a>
        </h1>
        <div class="page-header-actions">
            <a asp-controller="Timeline" asp-action="Index" class="btn btn-secondary">Back to Timeline</a>
        </div>
    </div>

    @if (!Model.Notes.Any())
    {
        @await Html.PartialAsync("../Shared/_EmptyState", new EmptyStateModel
        {
            Title = $"No notes for @Model.Tag",
            Hint = "Be the first to post with this hashtag!"
        })
    }
    else
    {
        <div class="hashtag-feed" data-feed data-card-selector=".note-card">
            @foreach (var note in Model.Notes)
            {
                <div class="note-card" data-activity-id="@note.ActivityId">
                    <div class="note-header">
                        <a asp-controller="Profile" asp-action="Index" asp-route-username="@note.AuthorUsername" class="note-author-link">
                            <span class="note-author-name">@note.AuthorName</span>
                            <span class="note-author-username">@note.AuthorUsername</span>
                        </a>
                        <span class="note-time">@TimeAgo(note.Published)</span>
                    </div>
                    <p class="note-content">@HighlightHashtag(note.Content, Model.Tag)</p>
                </div>
            }
        </div>

        @if (Model.HasMore)
        {
            <div class="load-more-container" data-page="@Model.Page"
                 data-next="@Url.Action("Index", "Hashtag", new { tag = Model.Tag.TrimStart('#'), page = Model.Page + 1 })">
                <a class="btn btn-secondary load-more-btn" role="button">Load more</a>
            </div>
            <div id="load-more-skeleton" class="timeline-loading" aria-hidden="true">
                @await Html.PartialAsync("../Shared/_SkeletonNoteCard", false)
            </div>
        }
    }
</div>

@functions {
    string TimeAgo(DateTime dateTime)
    {
        var span = DateTime.UtcNow - dateTime;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }

    string HighlightHashtag(string text, string tag)
    {
        if (string.IsNullOrEmpty(text)) return "";
        var lower = text.ToLowerInvariant();
        var tagLower = tag.ToLowerInvariant();
        var idx = lower.IndexOf(tagLower);
        if (idx < 0) return text;

        return text.Substring(0, idx) +
               $"<mark class=\"hashtag-highlight\">{text.Substring(idx, tag.Length)}</mark>" +
               text.Substring(idx + tag.Length);
    }
}
