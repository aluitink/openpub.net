@{
    ViewData["Title"] = "Notifications";
    ViewData["PageClass"] = "notifications";
}
@model NotificationsViewModel

<div class="notifications-container">
    <div class="page-header">
        <h1>Notifications</h1>
        @if (Model.Items.Count > 0)
        {
            <div class="page-header-actions">
                <form asp-controller="Notifications" asp-action="MarkAllRead" method="post" class="inline-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-secondary btn-sm">Mark all as read</button>
                </form>
            </div>
        }
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="empty-notifications">
            <p>No notifications yet. When people interact with your notes, you'll see them here.</p>
        </div>
    }
    else
    {
        var grouped = Model.Items
            .GroupBy(i => i.NotificationType)
            .OrderByDescending(g => g.First().Published)
            .ToList();

        @foreach (var group in grouped)
        {
            var typeLabel = group.Key switch
            {
                "follow" => "Follows",
                "follow_accept" => "Follow Accepts",
                "like" => "Likes",
                "boost" => "Boosts",
                "reply" => "Replies",
                _ => "Other"
            };

            <div class="notification-group">
                <h3 class="notification-group-header">@typeLabel <span class="notification-group-count">@group.Count()</span></h3>
                <div class="notifications-list">
                    @foreach (var item in group)
                    {
                        <div class="notification-item @(item.NotificationType)" data-notification-id="@item.ActivityId">
                            <div class="notification-icon">
                                @{
                                    var icon = item.NotificationType switch
                                    {
                                        "follow" => "&#10133;",
                                        "follow_accept" => "&#10003;",
                                        "like" => "&#10084;",
                                        "boost" => "&#128264;",
                                        "reply" => "&#10148;",
                                        _ => "&#9889;"
                                    };
                                }
                                <span>@icon</span>
                            </div>
                            <div class="notification-content">
                                <p class="notification-title">
                                    <a asp-controller="Profile" asp-action="Index" asp-route-username="@item.ActorName">@item.ActorDisplayName</a>
                                    @item.Title.Replace(item.ActorDisplayName, "")
                                </p>
                                @if (!string.IsNullOrEmpty(item.TargetNote) && !string.IsNullOrEmpty(item.TargetActivityId))
                                {
                                    <a class="notification-note notification-note-link"
                                       href="/timeline?note=@Uri.EscapeDataString(item.TargetActivityId)"
                                       title="View source note">@item.TargetNote</a>
                                }
                                else if (!string.IsNullOrEmpty(item.TargetNote))
                                {
                                    <p class="notification-note">@item.TargetNote</p>
                                }
                            </div>
                            <div class="notification-time">
                                <span data-published="@item.Published.ToString("O")">@TimeAgo(item.Published)</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (Model.HasMore)
        {
            <div class="notifications-pagination">
                <a asp-controller="Notifications" asp-action="Index" asp-route-page="@(Model.Page + 1)" class="btn btn-secondary">Load More</a>
            </div>
        }
    }
</div>

@functions {
    string TimeAgo(DateTime dateTime)
    {
        var span = DateTime.UtcNow - dateTime;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        return $"{(int)span.TotalDays}d ago";
    }
}
