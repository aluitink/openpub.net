@model RateLimitSettingsViewModel
@{
    ViewData["Title"] = "Rate Limit Settings";
}

<div class="page-header">
    <h1>Rate Limit Settings</h1>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="Update" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <h3>Compose Endpoint</h3>
        <div class="row">
            <div class="col">
                <label class="form-label">Requests per window</label>
                <input type="number" name="Compose.Limit" class="form-control" value="@Model.Compose.Limit" min="1" max="100" />
            </div>
            <div class="col">
                <label class="form-label">Window (minutes)</label>
                <input type="number" name="Compose.WindowMinutes" class="form-control" value="@Model.Compose.WindowMinutes" min="1" max="60" />
            </div>
        </div>
    </div>

    <div class="mb-3">
        <h3>Follow Endpoint</h3>
        <div class="row">
            <div class="col">
                <label class="form-label">Requests per window</label>
                <input type="number" name="Follow.Limit" class="form-control" value="@Model.Follow.Limit" min="1" max="50" />
            </div>
            <div class="col">
                <label class="form-label">Window (minutes)</label>
                <input type="number" name="Follow.WindowMinutes" class="form-control" value="@Model.Follow.WindowMinutes" min="1" max="60" />
            </div>
        </div>
    </div>

    <div class="mb-3">
        <h3>Upload Endpoint</h3>
        <div class="row">
            <div class="col">
                <label class="form-label">Requests per window</label>
                <input type="number" name="Upload.Limit" class="form-control" value="@Model.Upload.Limit" min="1" max="50" />
            </div>
            <div class="col">
                <label class="form-label">Window (minutes)</label>
                <input type="number" name="Upload.WindowMinutes" class="form-control" value="@Model.Upload.WindowMinutes" min="1" max="60" />
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Settings</button>
    <a asp-controller="Admin" asp-action="Moderation" class="btn btn-secondary">Back</a>
</form>
