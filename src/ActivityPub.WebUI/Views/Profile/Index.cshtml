@{
    ViewData["Title"] = Model.DisplayName;
}
@model ProfileViewModel

<div class="profile-page">
    @if (!Model.IsOwnProfile)
    {
        <a asp-controller="Timeline" asp-action="Index" class="btn btn-secondary back-link">Back to Timeline</a>
    }

    @if (!string.IsNullOrEmpty(Model.BannerUrl))
    {
        <div class="profile-banner" style="background-image: url('@Model.BannerUrl')"></div>
    }
    else
    {
        <div class="profile-banner profile-banner-default"></div>
    }

    <div class="profile-info">
        <div class="profile-avatar">
            @if (!string.IsNullOrEmpty(Model.IconUrl))
            {
                <img src="@Model.IconUrl" alt="@Model.DisplayName" fetchpriority="high" width="90" height="90" />
            }
            else
            {
                <div class="avatar-placeholder avatar-placeholder-lg">@(Model.DisplayName.FirstOrDefault() != default ? Model.DisplayName.ToString().Substring(0, 1).ToUpperInvariant() : "?")</div>
            }
        </div>

        <div class="profile-details">
            <h1>@Html.Raw(Model.DisplayName)</h1>
            <span class="profile-username">@Model.Username</span>

            @if (!string.IsNullOrEmpty(Model.Bio))
            {
                <p class="profile-bio">@Html.Raw(Model.Bio)</p>
            }

            <div class="profile-stats">
                <span class="stat"><strong>@Model.NoteCount</strong> Notes</span>
                <span class="stat"><strong>@Model.FollowerCount</strong> Followers</span>
                <span class="stat"><strong>@Model.FollowingCount</strong> Following</span>
            </div>
            <span class="profile-joined">Joined @Model.JoinedDate</span>
        </div>

        <div class="profile-actions">
            @if (Model.IsOwnProfile)
            {
                <a asp-action="Edit" class="btn btn-secondary">Edit Profile</a>
            }
            else
            {
                @if (Model.IsFollowing)
                {
                    <form asp-action="Unfollow" method="post" class="inline-form">
                        <input type="hidden" name="actorId" value="@Model.TargetActorId" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="btn btn-secondary btn-follow-state">Following</button>
                    </form>
                }
                else
                {
                    <form asp-action="Follow" method="post" class="inline-form">
                        <input type="hidden" name="actorId" value="@Model.TargetActorId" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="btn btn-primary btn-follow-state">Follow</button>
                    </form>
                }
            }
        </div>
    </div>
</div>
