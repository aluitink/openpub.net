@model FederationHealthViewModel
@{
    ViewData["Title"] = "Federation Health";
}

<div class="federation-health">
    <div class="page-header">
        <h1>Federation Health Monitor</h1>
    </div>

    <div class="admin-nav">
        <a asp-controller="Admin" asp-action="Moderation" class="btn btn-secondary">Back to Moderation</a>
    </div>

    <div class="health-status-banner status-@Model.OverallStatus.ToLower()">
        <h2>Overall Status: @Model.OverallStatus</h2>
        <span class="last-checked">Last checked: @Model.LastChecked.ToString("yyyy-MM-dd HH:mm:ss UTC")</span>
    </div>

    <div class="health-grid">
        <div class="health-card">
            <h3>Delivery Queue</h3>
            <table class="health-table">
                <tr><td>Pending</td><td>@Model.DeliveryQueue!.PendingCount</td></tr>
                <tr><td>Failed</td><td>@Model.DeliveryQueue.FailedCount</td></tr>
                <tr><td>Max Retries Exceeded</td><td>@Model.DeliveryQueue.MaxRetriesExceededCount</td></tr>
                <tr><td>Error Rate</td><td>@Model.DeliveryQueue.ErrorRate:F1%</td></tr>
                <tr><td>Oldest Pending</td><td>@(Model.DeliveryQueue.OldestPending?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td></tr>
                <tr><td>Last Successful</td><td>@(Model.DeliveryQueue.LastSuccessfulDelivery?.ToString("yyyy-MM-dd HH:mm") ?? "N/A")</td></tr>
            </table>
        </div>

        <div class="health-card">
            <h3>Activity Processing</h3>
            <table class="health-table">
                <tr><td>Total Activities</td><td>@Model.ActivityProcessing!.TotalActivities</td></tr>
                <tr><td>Last Hour</td><td>@Model.ActivityProcessing.ActivitiesLastHour</td></tr>
                <tr><td>Last Day</td><td>@Model.ActivityProcessing.ActivitiesLastDay</td></tr>
            </table>
            @if (Model.ActivityProcessing.ActivityTypes.Any())
            {
                <h4>Activity Types</h4>
                <table class="health-table">
                    @foreach (var kv in Model.ActivityProcessing.ActivityTypes.OrderByDescending(x => x.Value).Take(10))
                    {
                        <tr><td>@kv.Key</td><td>@kv.Value</td></tr>
                    }
                </table>
            }
        </div>

        <div class="health-card">
            <h3>Database</h3>
            <table class="health-table">
                <tr><td>Actors</td><td>@Model.Database!.TotalActors</td></tr>
                <tr><td>Activities</td><td>@Model.Database.TotalActivities</td></tr>
                <tr><td>Deliveries</td><td>@Model.Database.TotalDeliveries</td></tr>
            </table>
        </div>
    </div>

    <h3>Remote Server Probes</h3>
    <form asp-action="ProbeServers" method="post" class="probe-form">
        <div class="probe-input-row">
            <input type="text" name="newDomain" placeholder="e.g. mastodon.social" aria-label="Domain to check" class="form-control" />
            <button type="submit" class="btn btn-primary">Probe</button>
        </div>
    </form>

    @if (Model.ProbeResults != null && Model.ProbeResults.Any())
    {
        <table class="admin-table health-table">
            <thead>
                <tr>
                    <th>Domain</th>
                    <th>Reachable</th>
                    <th>Response Time</th>
                    <th>Error</th>
                    <th>Probed At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in Model.ProbeResults)
                {
                    <tr>
                        <td>@result.Domain</td>
                        <td>
                            <span class="badge-status @(result.Reachable ? "delivered" : "failed")">
                                @(result.Reachable ? "Yes" : "No")
                            </span>
                        </td>
                        <td>@(result.Reachable ? $"{result.ResponseTimeMs}ms" : "-")</td>
                        <td>@(result.ErrorMessage ?? "-")</td>
                        <td>@result.ProbedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h3>Recent Delivery Errors</h3>
    @if (Model.RecentErrors.Any())
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Activity</th>
                    <th>Target</th>
                    <th>Error</th>
                    <th>Retries</th>
                    <th>Last Attempt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var error in Model.RecentErrors)
                {
                    <tr>
                        <td title="@error.ActivityId">@error.ActivityId[..Math.Min(12, error.ActivityId.Length)]...</td>
                        <td title="@error.TargetActorId">@error.TargetActorId[..Math.Min(40, error.TargetActorId.Length)]...</td>
                        <td>@error.FailureReason</td>
                        <td>@error.RetryCount</td>
                        <td>@error.LastAttempt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="admin-empty">
            @await Html.PartialAsync("../Shared/_EmptyState", new EmptyStateModel
            {
                Title = "No recent delivery errors",
                Hint = "Outbound federation delivery failures will appear here."
            })
        </div>
    }
</div>
