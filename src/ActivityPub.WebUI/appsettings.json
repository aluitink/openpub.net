{
  "ActivityPub": {
    "Domain": "localhost",
    "UserPath": "/users",
    "InboxPath": "/inbox",
    "EnableFederation": true,
    "EnableSignatureVerification": true,
    "RequireSignatures": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
