{
  "ActivityPub": {
    "Domain": "localhost",
    "UserPath": "/users",
    "InboxPath": "/inbox",
    "EnableFederation": true,
    "EnableSignatureVerification": true,
    "RequireSignatures": false,
    "Cache": {
      "Provider": "Memory",
      "RedisConnection": "localhost:6379",
      "CachePrefix": "activitypub:"
    },
    "Realtime": {
      "Enabled": false,
      "RedisConnection": "localhost:6379",
      "ChannelPrefix": "activitypub:signalr:",
      "MaxMessagesPerWindow": 50,
      "Window": "00:01:00"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
