{
  "ActivityPub": {
    "Domain": "localhost",
    "UserPath": "/users",
    "InboxPath": "/inbox",
    "EnableFederation": true,
    "EnableSignatureVerification": true,
    "RequireSignatures": false,
    "Cache": {
      "Provider": "Memory",
      "RedisConnection": "localhost:6379",
      "CachePrefix": "activitypub:"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
