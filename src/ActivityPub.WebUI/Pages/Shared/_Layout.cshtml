<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fediblog</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar">
            <div class="nav-container">
                <a asp-controller="Home" asp-action="Index" class="brand">Fediblog</a>
                <div class="nav-links">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <a asp-controller="Timeline" asp-action="Index" class="nav-link">Timeline</a>
                        <a asp-controller="Compose" asp-action="Index" class="nav-link">Compose</a>
                        <a asp-controller="Follow" asp-action="Index" class="nav-link">Follow</a>
                        <a asp-controller="Follow" asp-action="Following" class="nav-link">Following</a>
                        <a asp-controller="Follow" asp-action="Followers" class="nav-link">Followers</a>
                        <a asp-controller="Profile" asp-action="Index" class="nav-link">Profile</a>
                        <a asp-controller="Notifications" asp-action="Index" class="nav-link">
                            Notifications <span id="notification-badge" class="notification-badge" style="display:none">0</span>
                        </a>
                        <a asp-controller="Search" asp-action="Index" class="nav-link">Search</a>
                        <span class="user-greeting">Hello, @User.Identity.Name</span>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="inline-form">
                            <button type="submit" class="btn btn-secondary">Logout</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-secondary">Login</a>
                        <a asp-controller="Auth" asp-action="Register" class="btn btn-primary">Register</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="main-container">
        <main>
            @RenderBody()
        </main>
    </div>
    <footer>
        <div class="footer-container">
            <p>Fediblog - A federated microblogging platform powered by ActivityPub.NET</p>
        </div>
    </footer>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <script src="https://cdn.jsdelivr.net/npm/%40microsoft/signalr@8.0.0/dist/browser/signalr.min.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var connection = new signalR.HubConnectionBuilder()
                    .withUrl('/notifications/ws')
                    .withAutomaticReconnect()
                    .build();

                var notificationCount = 0;
                var badge = document.getElementById('notification-badge');

                connection.on('NewActivity', function(data) {
                    notificationCount++;
                    if (badge) {
                        badge.textContent = notificationCount;
                        badge.style.display = 'inline';
                    }
                    console.log('[SignalR] New activity:', data.Type, 'by', data.ActorName);
                });

                connection.on('NewNotification', function(data) {
                    notificationCount++;
                    if (badge) {
                        badge.textContent = notificationCount;
                        badge.style.display = 'inline';
                    }
                    console.log('[SignalR] Notification:', data.Type, data.Message);
                });

                connection.on('Connected', function(username) {
                    console.log('[SignalR] Connected as', username);
                });

                connection.start().catch(function(err) {
                    console.log('[SignalR] Connection failed:', err);
                });
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
