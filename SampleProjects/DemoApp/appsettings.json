{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "DemoApp.Services": "Information"
    }
  },
  "ActivityPub": {
    "Domain": "localhost",
    "UserPath": "/users",
    "Port": 8080
  },
  "Security": {
    "RateLimiting": {
      "Enabled": true,
      "WindowMinutes": 1,
      "MaxRequests": 100
    },
    "IPFiltering": {
      "Enabled": false,
      "Whitelist": [],
      "Blacklist": []
    },
    "TokenExpiryHours": 24
  },
  "AllowedHosts": "*"
}
